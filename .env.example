# OpenCorporates API-Token (optional, aber empfohlen).
# Ohne Token funktioniert die Suche im anonymen Modus mit strengen Rate-Limits.
# Token anfordern: https://opencorporates.com/api_accounts/new
OPENCORPORATES_API_TOKEN=

# Standard-Land (ISO-Code) für die Registersuche. Für Deutschland: de
DEFAULT_COUNTRY_CODE=de

# Overpass-API-Endpunkt (OpenStreetMap-Firmensuche). Optional.
# Standard: https://overpass-api.de/api/interpreter
# Alternativen bei Rate-Limits: https://overpass.kumi.systems/api/interpreter
OVERPASS_URL=
